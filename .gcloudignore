# Keep the public image small AND guarantee no secrets/PII enter the build.
# VCS / envs / caches
.git
.venv
**/__pycache__
*.py[cod]
.tmp
.databricks
.playwright-cli
catboost_info
**/.DS_Store
databricks.yml

# Not needed by the standalone app
databricks/
scripts/
resources/
docs/
output/mlruns/
output/catboost/
output/sql/
output/playwright/
*.pdf
*.png
*.md
*.ipynb

# Ship only the small public aggregate artifacts needed by DATA_BACKEND=csv.
output/data/*
!output/data/facility_health_cleaned.csv
!output/data/district_health_facility_cleaned.csv
!output/data/intervention_recommendations.csv
!output/data/intervention_recommendations_summary.json
!output/data/conformal_calibration.json
!output/data/conformal_facility_sets.csv
!output/data/golden_facility_seed_report.json
!output/data/facility_prediction_model_report.json
!output/data/decision_category_volume_summary.csv
!output/data/statistical_decision_policy_report.json
!output/data/geocoder_uncertainty_priors.csv
!output/data/active_learning_district_queue.csv

